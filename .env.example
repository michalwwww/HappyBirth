# ==============================================================================
# HAPPYBIRTH - TEMPLATE ZMIENNYCH ŚRODOWISKOWYCH (.env.local)
# Skopiuj ten plik do `.env.local` i uzupełnij prawdziwymi danymi.
# Nigdy nie commituj pliku `.env.local` do repozytorium!
# ==============================================================================

# Domena aplikacji
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Stream (Wideo)
CLOUDFLARE_ACCOUNT_ID=twoj_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=twoj_cloudflare_stream_api_token
NEXT_PUBLIC_CLOUDFLARE_STREAM_DOMAIN=customer-xxx.cloudflarestream.com

# Cloudflare D1 (Baza danych SQL)
CLOUDFLARE_D1_DATABASE_ID=twoj_d1_database_id
CLOUDFLARE_D1_API_TOKEN=twoj_d1_api_token

# Autoryzacja i sesje (min. 32 znaki)
SESSION_SECRET=losowy_bezpieczny_ciag_znakow_minimum_32_znaki_tutaj

# E-maile transakcyjne (Resend)
RESEND_API_KEY=re_twoj_resend_api_key

# Płatności Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...
